# Baby Got Tools — frontend (Next.js) — template
# Copy to .env and adjust. NEVER commit secrets.

# Canonical production origin (sitemap, robots, canonical URLs, og:url).
# Set to the REAL deployed domain. No trailing slash, https.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Dev proxy for the optional backend API (matches backend PORT).
API_PROXY_TARGET=http://127.0.0.1:4000

# Browser-side API base (same-origin proxy by default).
NEXT_PUBLIC_API_BASE=/api/v1
